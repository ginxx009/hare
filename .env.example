# --- Self-hosted (Docker) -------------------------------------------------
# Run scripts/owner-setup.sh once: it writes the HARE_* values below into .env
# and prints the access key + authenticator secret to a file only you open.

# OpenAI key for reviews (model defaults to gpt-5-mini).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional fallback: xAI key, used only when OPENAI_API_KEY is empty.
XAI_API_KEY=

# Public URL of this Hare instance (your ngrok address), e.g. https://example.ngrok-free.app
APP_URL=

HARE_DB_PASSWORD=
HARE_OWNER_ACCESS_KEY_SHA256=
HARE_OWNER_TOTP_SECRET=
HARE_SESSION_SECRET=

# --- Grok-hosted only -----------------------------------------------------
# Postgres connection string (set automatically by docker-compose when self-hosting).
DATABASE_URL=
